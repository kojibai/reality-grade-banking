            "public",
            "private"
          ]
        },
        "allowedSubjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedSubjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerBlocklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "subjectId",
        "visibility",
        "allowedSubjectIds",
        "blockedSubjectIds",
        "ownerBlocklist",
        "policyDigest"
      ],
      "additionalProperties": false
    },
    "subjectInventory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.inventory.v1",
      "title": "receiz.subject.inventory.v1",
