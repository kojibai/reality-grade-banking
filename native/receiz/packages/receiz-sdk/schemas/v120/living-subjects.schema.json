        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "schema",
        "subjectId",
        "head",
        "items"
      ],
      "additionalProperties": false
    },
    "subjectTradeIntent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
