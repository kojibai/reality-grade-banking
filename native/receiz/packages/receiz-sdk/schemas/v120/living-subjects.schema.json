    "subjectRuntimeJob": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.runtime_job.v1",
      "title": "receiz.subject.runtime_job.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.runtime_job.v1"
        },
        "jobId": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "status": {
          "enum": [
            "queued",
            "leased",
            "completed",
            "failed",
            "cancelled",
            "stale"
          ]
        },
        "leaseUntilKai": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failureCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "jobId",
        "input",
        "status",
        "leaseUntilKai",
        "attemptCount",
        "eventIds",
        "failureCode"
      ],
      "additionalProperties": false
    },
