        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
