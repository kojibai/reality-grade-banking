{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.receiz.com/v120/living-subjects.schema.json",
  "title": "Receiz v120 Living Proof Subjects",
  "version": "120.0.0",
  "schemas": {
    "subject": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.v1",
      "title": "receiz.subject.v1",
      "description": "Immutable subject identity bound to append-only proof, ownership, and byte-preserved namespaces.",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.v1"
        },
        "subjectId": {
          "type": "string"
        },
        "proofObjectId": {
          "type": "string"
        },
        "subjectType": {
          "type": "string"
        },
        "ownerReceizId": {
          "type": "string"
        },
        "identityDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "genesisDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "createdAtKai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownershipHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "currentOwnerReceizId": {
          "type": "string"
        },
        "namespaces": {
          "type": "object",
          "description": "Extensible namespace bytes encoded as base64url. Unknown keys and exact values must be preserved byte-for-byte.",
          "required": [
            "identity",
            "canonicalState",
            "selfModel",
            "memory",
            "relationships",
            "inventory",
            "abilities",
            "condition",
            "worldPosition",
            "mandates",
            "eventHistory",
            "projections",
            "applicationNamespaces"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "required": [
        "schema",
        "subjectId",
        "proofObjectId",
        "subjectType",
        "ownerReceizId",
        "identityDigest",
        "genesisDigest",
        "createdAtKai",
        "head",
        "ownershipHead",
        "currentOwnerReceizId",
        "namespaces"
      ],
      "additionalProperties": false
    },
    "subjectMind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.mind.v1",
      "title": "receiz.subject.mind.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.mind.v1"
        },
        "subjectArtifact": {
          "type": "object",
          "additionalProperties": true
        },
        "brainHead": {
          "type": "object",
          "additionalProperties": true
        },
        "portableWindow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "completeHistory": {
          "type": "object",
          "additionalProperties": true
        },
        "publicMemoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privateMemoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priorMindHead": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mindDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exactBytesB64u": {
          "type": "string"
        },
        "registryDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reducerDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "subjectArtifact",
        "brainHead",
        "portableWindow",
        "completeHistory",
        "publicMemoryIds",
        "privateMemoryIds",
        "priorMindHead",
        "mindDigest",
        "exactBytesB64u",
        "registryDigest",
        "reducerDigest"
      ],
      "additionalProperties": false
    },
    "subjectSelfModel": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.self_model.v1",
      "title": "receiz.subject.self_model.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.self_model.v1"
        },
        "subjectId": {
          "type": "string"
        },
        "subjectHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "namespaceBytes": {
          "type": "string"
        },
        "selfModelDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "subjectId",
        "subjectHead",
        "namespaceBytes",
        "selfModelDigest"
      ],
      "additionalProperties": false
    },
    "subjectMandate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.mandate.v1",
      "title": "receiz.subject.mandate.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.mandate.v1"
        },
        "mandateId": {
          "type": "string"
        },
        "subjectId": {
          "type": "string"
        },
        "ownerReceizId": {
          "type": "string"
        },
        "policy": {
          "type": "object",
          "additionalProperties": true
        },
        "mandateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "paused",
            "revoked",
            "expired"
          ]
        },
        "activatedCapabilityDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "activatedAtKai": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revokedAtKai": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "mandateId",
        "subjectId",
        "ownerReceizId",
        "policy",
        "mandateDigest",
        "status",
        "activatedCapabilityDigest",
        "activatedAtKai",
        "revokedAtKai"
      ],
      "additionalProperties": false
    },
    "subjectCapability": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.capability.v1",
      "title": "receiz.subject.capability.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.capability.v1"
        },
        "subjectId": {
          "type": "string"
        },
        "receizId": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expiresAtKai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "capabilityDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "subjectId",
        "receizId",
        "actions",
        "expiresAtKai",
        "capabilityDigest"
      ],
      "additionalProperties": false
    },
    "subjectIntent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.intent.v1",
      "title": "receiz.subject.intent.v1",
      "description": "Non-authoritative model output. World effects require deterministic command admission.",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.intent.v1"
        },
        "speech": {
          "type": "string"
        },
        "proposedIntents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "memoryCitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": true
        },
        "modelAudit": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "schema",
        "proposedIntents",
        "memoryCitations",
        "modelAudit"
      ],
      "additionalProperties": false
    },
    "subjectMemoryEvent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.memory_event.v1",
      "title": "receiz.subject.memory_event.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.memory_event.v1"
        },
        "memoryId": {
          "type": "string"
        },
        "subjectId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "conversation",
            "episodic-world",
            "relationship",
            "battle",
            "discovery",
            "ownership-care",
            "inventory-trade"
          ]
        },
        "summary": {
          "type": "string"
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proofObjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kai": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "schema",
        "memoryId",
        "subjectId",
        "type",
        "summary",
        "eventIds",
        "proofObjectIds",
        "visibility",
        "head",
        "kai"
      ],
      "additionalProperties": false
    },
    "subjectMemoryProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.memory_projection.v1",
      "title": "receiz.subject.memory_projection.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.memory_projection.v1"
        },
        "subjectId": {
          "type": "string"
        },
        "throughHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "memories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "projectionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rebuildable": {
          "const": true
        }
      },
      "required": [
        "schema",
        "subjectId",
        "throughHead",
        "memories",
        "projectionDigest",
        "rebuildable"
      ],
      "additionalProperties": false
    },
    "subjectRelationship": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "receiz.subject.relationship.v1",
      "title": "receiz.subject.relationship.v1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "receiz.subject.relationship.v1"
        },
        "relationshipId": {
          "type": "string"
        },
        "subjectIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "proposed",
            "active",
            "declined",
            "blocked"
          ]
        },
        "familiarity": {
          "type": "number"
        },
        "trust": {
          "type": "number"
        },
        "rivalry": {
          "type": "number"
        },
        "affection": {
          "type": "number"
        },
        "mentorship": {
          "type": "number"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "relationshipId",
        "subjectIds",
        "status",
        "familiarity",
        "trust",
        "rivalry",
        "affection",
        "mentorship",
        "visibility",
        "eventIds",
        "head"
      ],
      "additionalProperties": false
    },
    "subjectInteractionPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
