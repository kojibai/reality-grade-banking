      "required": [
        "schema", "subjectId", "proofObjectId", "subjectType", "ownerReceizId", "identityDigest",
        "genesisDigest", "createdAtKai", "head", "ownershipHead", "currentOwnerReceizId", "namespaces"
      ],
      "properties": {
        "schema": { "const": "receiz.subject.v1" },
        "subjectId": { "$ref": "#/$defs/text" },
        "proofObjectId": { "$ref": "#/$defs/text" },
        "subjectType": { "$ref": "#/$defs/text" },
        "ownerReceizId": { "$ref": "#/$defs/receizId" },
        "identityDigest": { "$ref": "#/$defs/hex64" },
        "genesisDigest": { "$ref": "#/$defs/hex64" },
        "createdAtKai": { "$ref": "#/$defs/kai" },
        "head": { "$ref": "#/$defs/hex64" },
        "ownershipHead": { "$ref": "#/$defs/hex64" },
        "currentOwnerReceizId": { "$ref": "#/$defs/receizId" },
        "namespaces": {
          "type": "object",
          "required": [
            "identity", "canonicalState", "selfModel", "memory", "relationships", "inventory", "abilities",
            "condition", "worldPosition", "mandates", "eventHistory", "projections", "applicationNamespaces"
          ],
          "properties": {
            "identity": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "canonicalState": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "selfModel": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "memory": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "relationships": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "inventory": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "abilities": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "condition": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "worldPosition": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "mandates": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "eventHistory": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "projections": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
            "applicationNamespaces": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" }
          },
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256 },
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" }
        }
      }
    }
  }
}
