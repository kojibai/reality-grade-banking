              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sourceFamilybinding"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "committedTransition": {
                "properties": {
                  "acceptance": {
                    "const": "committed"
                  }
                },
                "required": [
