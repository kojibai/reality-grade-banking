# Unified patches retain whitespace-only context lines from their source.
docs/*.patch -whitespace

# Bundled dependencies contain significant template-literal whitespace.
public/native/*.mjs -whitespace

# Matching upstream sources preserve their original bytes, including whitespace.
native/** -text -whitespace
public/native/** -text
public/zk/** -text

# Standalone reader preserves bundled template-literal whitespace exactly.
public/vault-verifier/v1/inspector.js -whitespace
public/vault-verifier/v1/verify.html -whitespace
