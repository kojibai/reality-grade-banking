{
  "name": "receiz-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-public-pages.mjs && node scripts/build-license-notices.mjs && node scripts/check-conformance-build.mjs && node scripts/check-licensing.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "vercel:check": "node scripts/check-vercel-build.mjs",
    "market:seed": "node scripts/seed-public-market.mjs",
    "ledger:seed": "node scripts/seed-public-ledger.mjs",
    "bank:contract": "node scripts/compile-bank-domain.mts",
    "receiver:check": "node institution/check.mjs",
    "receiver:inspect": "node institution/inspect-note.mjs",
    "receiver:build": "node scripts/build-receiver-verifier.mjs",
    "conformance:check": "node scripts/check-conformance-build.mjs",
    "license:check": "node scripts/check-licensing.mjs"
  },
  "dependencies": {
    "@receiz/ai-skills": "129.0.0",
    "@receiz/mcp-server": "129.0.0",
    "@receiz/sdk": "129.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "21.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "underscore": "1.13.8"
  },
  "license": "GPL-3.0-only",
  "author": "Brian Joseph Klock (BJ Klock)"
}
