{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    },
    "api/receipt.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/receipt/index.html,scripts/social/fonts/*.ttf}"
    },
    "api/asset.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/explore/index.html,public/receiz-public-market.json,public/receiz-public-sports.json,scripts/social/fonts/*.ttf}"
    },
    "api/profile.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/explore/index.html,server/profile-runtime/**}"
    },
    "api/cooperatives.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/id",
      "destination": "/id/index.html"
    },
    {
      "source": "/id/",
      "destination": "/id/index.html"
    },
    {
      "source": "/learn/identity-continuity",
      "destination": "/id/index.html"
    },
    {
      "source": "/learn/identity-continuity/",
      "destination": "/id/index.html"
    },
    {
      "source": "/your-twin",
      "destination": "/your-twin/index.html"
    },
    {
      "source": "/your-twin/",
      "destination": "/your-twin/index.html"
    },
    {
      "source": "/in-action",
      "destination": "/in-action/index.html"
    },
    {
      "source": "/in-action/",
      "destination": "/in-action/index.html"
    },
    {
      "source": "/cooperate",
      "destination": "/coops/index.html"
    },
    {
      "source": "/cooperate/",
      "destination": "/coops/index.html"
    },
    {
      "source": "/together",
      "destination": "/together/index.html"
    },
    {
      "source": "/together/",
      "destination": "/together/index.html"
    },
    {
      "source": "/together/creators",
      "destination": "/together/creators/index.html"
    },
    {
      "source": "/together/creators/",
      "destination": "/together/creators/index.html"
    },
    {
      "source": "/together/independent-work",
      "destination": "/together/independent-work/index.html"
    },
    {
      "source": "/together/independent-work/",
      "destination": "/together/independent-work/index.html"
    },
    {
      "source": "/together/businesses",
      "destination": "/together/businesses/index.html"
    },
    {
      "source": "/together/businesses/",
      "destination": "/together/businesses/index.html"
    },
    {
      "source": "/together/communities",
      "destination": "/together/communities/index.html"
    },
    {
      "source": "/together/communities/",
      "destination": "/together/communities/index.html"
    },
    {
      "source": "/together/how-it-works",
      "destination": "/together/how-it-works/index.html"
    },
    {
      "source": "/together/how-it-works/",
      "destination": "/together/how-it-works/index.html"
    },
    {
      "source": "/together/connect",
      "destination": "/together/connect/index.html"
    },
    {
      "source": "/together/connect/",
      "destination": "/together/connect/index.html"
    },
    {
      "source": "/protect",
      "destination": "/protect/index.html"
    },
    {
      "source": "/protect/",
      "destination": "/protect/index.html"
    },
    {
      "source": "/vaults",
      "destination": "/vaults/index.html"
    },
    {
      "source": "/vaults/",
      "destination": "/vaults/index.html"
    },
    {
      "source": "/fit",
      "destination": "/fit/index.html"
    },
    {
      "source": "/fit/",
      "destination": "/fit/index.html"
    },
    {
      "source": "/coops",
      "destination": "/coops/index.html"
    },
    {
      "source": "/coops/",
      "destination": "/coops/index.html"
    },
    {
      "source": "/cooperatives",
      "destination": "/cooperatives/index.html"
    },
    {
      "source": "/cooperatives/",
      "destination": "/cooperatives/index.html"
    },
    {
      "source": "/cooperatives/:page(producers|manufacturing|distribution|workers|energy|housing|federations|infrastructure|connect)",
      "destination": "/cooperatives/:page/index.html"
    },
    {
      "source": "/cooperatives/:page(producers|manufacturing|distribution|workers|energy|housing|federations|infrastructure|connect)/",
      "destination": "/cooperatives/:page/index.html"
    },
    {
      "source": "/vault/:vaultId/",
      "destination": "/vault/index.html"
    },
    {
      "source": "/vault/:vaultId",
      "destination": "/vault/index.html"
    },
    {
      "source": "/business",
      "destination": "/business/index.html"
    },
    {
      "source": "/business/",
      "destination": "/business/index.html"
    },
    {
      "source": "/business/for",
      "destination": "/business/for/index.html"
    },
    {
      "source": "/business/for/",
      "destination": "/business/for/index.html"
    },
    {
      "source": "/business/for/:fit(agencies|consultants|freelancers|designers|creators|musicians|authors|filmmakers|podcasters|coaches|educators|accountants|researchers|founders|service-businesses|real-estate|ecommerce|hospitality|teams|communities|events|nonprofits|project-leaders|product-builders|developers|startups|collectors|professionals|career-builders|knowledge-businesses)",
      "destination": "/business/for/:fit/index.html"
    },
    {
      "source": "/business/for/:fit(agencies|consultants|freelancers|designers|creators|musicians|authors|filmmakers|podcasters|coaches|educators|accountants|researchers|founders|service-businesses|real-estate|ecommerce|hospitality|teams|communities|events|nonprofits|project-leaders|product-builders|developers|startups|collectors|professionals|career-builders|knowledge-businesses)/",
      "destination": "/business/for/:fit/index.html"
    },
    {
      "source": "/oembed",
      "destination": "/api/asset?oembed=1"
    },
    {
      "source": "/oembed/",
      "destination": "/api/asset?oembed=1"
    },
    {
      "source": "/asset/:asset/player/",
      "destination": "/api/asset?asset=:asset&player=1"
    },
    {
      "source": "/asset/:asset/player",
      "destination": "/api/asset?asset=:asset&player=1"
    },
    {
      "source": "/asset/:asset/og.png",
      "destination": "/api/asset?asset=:asset&image=1"
    },
    {
      "source": "/asset/:asset/",
      "destination": "/api/asset?asset=:asset"
    },
    {
      "source": "/asset/:asset",
      "destination": "/api/asset?asset=:asset"
    },
    {
      "source": "/explorer",
      "destination": "/explore/index.html"
    },
    {
      "source": "/explorer/",
      "destination": "/explore/index.html"
    },
    {
      "source": "/receiz-public-ledger.json.gz",
      "destination": "/receiz-public-ledger.json.gz.bin"
    },
    {
      "source": "/receipt/:digest([a-f0-9]{64})/",
      "destination": "/api/receipt?s=:digest"
    },
    {
      "source": "/receipt/:digest([a-f0-9]{64})",
      "destination": "/api/receipt?s=:digest"
    },
    {
      "source": "/receipt/",
      "has": [
        {
          "type": "query",
          "key": "r"
        }
      ],
      "destination": "/api/receipt"
    },
    {
      "source": "/receipt/",
      "destination": "/receipt/index.html"
    },
    {
      "source": "/verify/:digest",
      "destination": "/verify/index.html"
    },
    {
      "source": "/verify/:digest/",
      "destination": "/verify/index.html"
    },
    {
      "source": "/api/bank/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/receiz/callback",
      "destination": "/index.html"
    },
    {
      "source": "/pay",
      "destination": "/pay/index.html"
    },
    {
      "source": "/pay/",
      "destination": "/pay/index.html"
    },
    {
      "source": "/pay/:username/",
      "destination": "/pay/index.html"
    },
    {
      "source": "/pay/:username",
      "destination": "/pay/index.html"
    },
    {
      "source": "/u/:username([a-z0-9_]{3,24})/",
      "destination": "/api/profile?username=:username"
    },
    {
      "source": "/u/:username([a-z0-9_]{3,24})",
      "destination": "/api/profile?username=:username"
    },
    {
      "source": "/:username([a-z0-9_]{3,24})/",
      "destination": "/api/profile?username=:username"
    },
    {
      "source": "/:username([a-z0-9_]{3,24})",
      "destination": "/api/profile?username=:username"
    }
  ]
}
