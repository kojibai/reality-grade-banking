{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    },
    "api/receipt.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/receipt/index.html,scripts/social/fonts/*.ttf}"
    }
  },
  "rewrites": [
    {"source":"/explorer","destination":"/explore/index.html"},
    {"source":"/explorer/","destination":"/explore/index.html"},
    {
      "source": "/receiz-public-ledger.json.gz",
      "destination": "/receiz-public-ledger.json.gz.bin"
    },
    {
      "source": "/receipt/",
      "has": [{"type":"query","key":"r"}],
      "destination": "/api/receipt"
    },
    {
      "source": "/receipt/",
      "destination": "/receipt/index.html"
    },
    {
      "source": "/verify/:digest",
      "destination": "/verify/index.html"
    },
    {
      "source": "/verify/:digest/",
      "destination": "/verify/index.html"
    },
    {
      "source": "/api/bank/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/receiz/callback",
      "destination": "/index.html"
    }
  ]
}
