{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/verify/:digest", "destination": "/verify/index.html" },
    { "source": "/verify/:digest/", "destination": "/verify/index.html" },
    { "source": "/api/bank/(.*)", "destination": "/api/index" },
    { "source": "/auth/receiz/callback", "destination": "/index.html" }
  ]
}
