{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    },
    "api/receipt.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/receipt/index.html,scripts/social/fonts/*.ttf}"
    },
    "api/asset.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/explore/index.html,public/receiz-public-market.json,public/receiz-public-sports.json,scripts/social/fonts/*.ttf}"
    },
    "api/profile.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/explore/index.html,server/profile-runtime/**}"
    },
    "api/cooperatives.ts": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://docs.bankeiz.com/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.bankeiz.com/:path*",
      "permanent": true
    }
  ],
