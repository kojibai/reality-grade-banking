{
  "name": "receiz-bank",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-account-entry.mjs && node scripts/build-note-specimen.mjs --check && node scripts/build-public-imagery.mjs --check && node scripts/build-product-previews.mjs --check && node scripts/build-meeting-previews.mjs --check && node scripts/build-business-seal-runtime.mjs --check && node scripts/build-pdf-resources.mjs && node scripts/build-icons.mjs && node scripts/build-identity-artwork.mjs --check && node scripts/build-asset-title-index.mjs --check && node scripts/build-social-images.mjs --check && node scripts/receiz-release.mjs && node scripts/build-proof-verifier.mjs && node scripts/build-receipt-preview.mjs && node scripts/build-invitation-preview.mjs && node scripts/build-asset-preview.mjs && node scripts/build-profile-preview.mjs && node scripts/build-booking-preview.mjs && node scripts/build-chart-valuation.mjs --check && node scripts/conformance-certificate.mjs --check && node scripts/build-registry-publisher.mjs && node scripts/build-registry-runtime.mjs && node scripts/build-vault-runtime.mjs && node scripts/build-vault-inspector.mjs && npm run typecheck && node scripts/build-build-demo.mjs && vite build && node scripts/build-public-pages.mjs && node scripts/build-docs.mjs --mirror && node scripts/build-source-archive.mjs && node scripts/build-license-notices.mjs && node scripts/build-public-market-render-build.mjs && node scripts/check-server-entrypoints.mjs && node scripts/check-registry-runtime.mjs && node scripts/build-offline-shell.mjs && node scripts/check-offline-shell.mjs && node scripts/check-conformance-build.mjs && node scripts/check-licensing.mjs && node scripts/check-source-archive.mjs && node scripts/check-public-pages.mjs && node scripts/build-public-delivery-output.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "social:build": "node scripts/build-social-images.mjs",
    "social:check": "node scripts/build-social-images.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "node scripts/check-fresh-owner-profile.mjs && node scripts/check-profile-first-response.mjs && node scripts/check-offline-proof-kit.mjs && node scripts/check-public-first-frames.mjs && node scripts/check-browser-regressions.mjs && node scripts/check-chart-period-layout.mjs && node scripts/check-account-opening-progress.mjs && node scripts/check-collectibles-browser.mjs && node scripts/check-meeting-browser.mjs && node scripts/check-asset-composer-browser.mjs",
    "test:vault-browser": "node scripts/check-vault-browser.mjs",
    "release:check": "node scripts/receiz-release.mjs",
    "server:check": "node scripts/check-server-entrypoints.mjs",
    "vercel:check": "node scripts/check-vercel-build.mjs",
    "market:seed": "node scripts/seed-public-market.mjs",
    "ledger:seed": "node scripts/seed-public-ledger.mjs",
    "bank:contract": "node scripts/compile-bank-domain.mts",
    "receiver:check": "node institution/check.mjs",
    "receiver:inspect": "node institution/inspect-note.mjs",
    "receiver:build": "node scripts/build-receiver-verifier.mjs",
    "conformance:check": "node scripts/check-conformance-build.mjs",
    "conformance:reference": "node scripts/conformance-reference.mjs",
    "conformance:contracts": "node scripts/conformance-contract.mjs",
    "conformance:assess": "node scripts/conformance-assess.mjs",
    "conformance:baseline": "node scripts/conformance-baseline.mjs",
    "license:check": "node scripts/check-licensing.mjs",
    "native:check": "node scripts/check-native-source.mjs && node scripts/check-native-resources.mjs && node scripts/build-identity-artwork.mjs --check",
    "native:rebuild": "node scripts/rebuild-native.mjs",
    "native:resources": "node scripts/check-native-resources.mjs",
    "source:verify": "node scripts/check-source-archive.mjs",
    "predev": "node scripts/build-registry-publisher.mjs && node scripts/build-pdf-resources.mjs && node scripts/build-profile-preview.mjs && node scripts/build-proof-verifier.mjs && node scripts/build-identity-artwork.mjs --check",
    "vault:reader:build": "node scripts/build-vault-inspector.mjs",
    "vault:inspect": "node public/vault-verifier/v1/verify.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "node docs-app/preview.mjs",
    "dns:provision": "node scripts/provision-business-dns.mjs",
    "previews:build": "node scripts/build-product-previews.mjs",
    "previews:check": "node scripts/build-product-previews.mjs --check",
    "imagery:build": "node scripts/build-public-imagery.mjs",
    "imagery:check": "node scripts/build-public-imagery.mjs --check",
    "test:collectibles-browser": "node scripts/check-collectibles-browser.mjs",
    "test:account-entry-freeze": "node scripts/check-account-entry.mjs && vitest run --maxWorkers=2 tests/account-entry-freeze.test.ts tests/native-identity-creation-image.test.ts tests/new-account-genesis.test.ts tests/native-identity-local-entry.test.ts tests/native-identity-wallet-entry.test.ts tests/device-identity-entry.test.ts tests/account-display-name.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "3.1156.0",
    "@receiz/ai-skills": "129.0.0",
    "@receiz/mcp-server": "129.0.0",
    "@receiz/sdk": "129.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@vercel/connect": "2.5.5",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "underscore": "1.13.8"
  },
  "license": "GPL-3.0-only",
  "author": "Brian Joseph Klock (BJ Klock)"
