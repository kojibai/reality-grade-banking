{"accountUid":null,"author":"receiz_mndkhlsmhqgaydl8ek.receiz.id","schema":"receiz.app.bankeiz.governance.public-document.v1","terms":{"kind":"charter","rules":{"allowMandates":true,"amendments":"Any voting member may propose replacement text. Every founder must ratify the new charter before members use it.","appealDays":3,"appeals":"During the three-day challenge period, any member may identify a disputed item and request a remedy. Two uninvolved members review the evidence before a decision can bind the library.","approvalPercent":60,"articles":[{"text":"Hand tools may be borrowed for seven days. Members who cannot reach the depot may nominate a pickup partner.","title":"Borrowing and access"},{"text":"Volunteers mark a damaged tool out of circulation and attach a repair estimate before requesting reimbursement.","title":"Repair reports"}],"decisions":"Each member has one vote. Policy and budget requests need at least two affirmative votes and 60% of the votes cast. Polls guide programming. In a single-seat election the highest count leads, with a fresh vote for a tie.","electorate":["receiz_mndkhlsmhqgaydl8ek.receiz.id","receiz_wxaigsv3phglofa9xs.receiz.id","receiz_ooirdevfwmm5lbe0jm.receiz.id","receiz_kx9kmxavzdmdjh4prt.receiz.id"],"founders":["receiz_mndkhlsmhqgaydl8ek.receiz.id","receiz_wxaigsv3phglofa9xs.receiz.id"],"membership":"Mira Sol and Cal Ward founded the library. Jo Bell and Ren Lake join them in its four-member voting assembly. Membership changes require a charter amendment.","minimumSupportPercent":50,"name":"Harbor Tool Library","offices":[{"eligibility":"Electorate","name":"Library steward","powers":"Schedule repair clinics and coordinate volunteer shifts.","procedure":"Members nominate themselves. Each voter chooses one candidate. A tie goes to a runoff.","recall":"Two voters may petition for a recall election.","seats":1,"selection":"Election","term":"One six-month term."},{"eligibility":"Open","name":"Safety reviewer","powers":"Review equipment incidents and report maintenance needs.","procedure":"The assembly invites two trained volunteers and records their acceptance.","recall":"The assembly can replace a reviewer after an open hearing.","seats":2,"selection":"Custom","term":"One season."}],"purpose":"Neighbors share tools, teach safe repairs and keep borrowing affordable in Harbor Ward.","representation":"A member may name one voting member to act for a single decision category. The mandate must precede the proposal and remain in force when the representative votes. A member’s own ballot takes precedence.","treasury":"Tool repairs have a $900 quarterly limit. A payment needs an itemized quote, an approved budget and independent release by two authorized members. A request or ballot alone cannot release money.","voteDays":7}},"visibility":"public"}
	 		 
                    	 	 	  	 			 		   		  		   	  			 	  			 	   	 	 		  		  		  		   	  		   	  			 	   			  		  		 		  	   		  			 		   		  	  	 	 		  			 			 		  			 	 					 				 	   		   	 	    		 	 	   	 		 	 		 		  	   	 	   	  			  	 			 			 	  		 	 	  	    	     	 			 	   			      		   	 	 	 		  		    	 				  	 	 		    	   	 	 		 	  	 	  			   		  		 	   	 	 	  	    	     	  		 	   	  		 	 		 	  	 	  	 		 	 	 		  		 		 	 				  	 	  		   		   	  		 		 	 	 	  		 		   	   		   	 	  	 	  				    		  			 	 	     		 		 	 	 	 			  	 		 	 		   	  	 	 	    		 	 	 		 	 		 		 		   		 		 	 	 	 	 	  		      		     			 	   			 			 	 		 	  		 	 	  	    		 	   	   		   		  		  		 		 				 		  	 	 	   	   	  		 	 		 	 		 		 	 		  			  	  		  	  	 	 			 			 	   			 		  	 	 	   	 		 	  	  	 	  		  		  	 	  	  		 			  			 			 	 	 	 	 		 	  	 				  	 			  	  	  				 			     	    		 	   	    		 		   		 	   	   			 		  	   			     			   	  		 			 			 	   	   	 	 		 		 	 	 	     			 			 		  	 	 			  		 	   	   			  	  	 		    	 		 	   		 	 	 				  	 			  		 	 		    			 	   	 		  	 		   		 		 		 	 		   	  	 		 	  		   	   		  		 		 	  	 	 	 	   	  			   		   	 		 	 	  		  			 			     	 		 	  	  	 	  	 		  	 			     		 	  	  		     			 	   				    				 	  	 		 	  	 	  		  		   	 				 	  	 	   	 	 	 	 	 	  			  	 					 	   	 	 	 	 	 	 		 	    			     	 	 	 	 		 		 	 		  			 		 	  	 	 	 	 	 			   	 			 	   		   	  		 			  			 	   		 		 	 		 		   	  	 	  	  	 		 	 	   	 	 		  	 		 	 	  			  	  	  	 	  	  		 	 			     				  	 	  		 	 	   	 	 		 		 	 		 	 		  		 	 	  		 			 	   	   	   	 	 		 				 	 	 	   	  	 	  		 	    	    		 	 	  	  				  	 	  		   	 	  		 		 	  	 			      		 	   	  		 	 			 	    	 		 	 	  		 	 			 		  	  				 	   			 	 		  	 		 	 	  	 	     	 	  	  	  	  	 			  	  		  		  		 	    	  				 				  	 		  	 	 	   	 	 			 	 	 	 	  	  	     	 		 	 	  			   	 		  	 	 	    	  	 		 	  		 	     		   	 	    		 	  				 	   			 				 	  		  	 	 		 	 	  			  	  	 	   	 	 	 		  	 		 	  	 		    			 	 	 				  	 	 	 			  		   	  		 			  	 		 	 			   	 			   	 	 	  		 		 		 	 	   			 	 	 		  	 	 	 	 		  		  			 	   		    	 			 	   		   	  		   		 			  		 	  	 		 	  	 		 			     		   		 		   	  	   	    		 	   	 	 			 		 			  				     		 			 	 		     			  	 		 				 		  	 	 	  			  	  				 	   	 	 	 	 			  		 	 	  		   	 	 		     		 	 	  		 		  			 		  	   			 		 	 		  	 		 	 		 		   	 	     	  			  	 	 	   		 	 		 	    	   			  	 				 	   			    		  	 	  		 			  		  	  		 	 		 	  		   	    	   		 	 	 	 	     		 	  	 		 		 	 		   	  	 		    	  		   				    		  	   			     	 					 	  				 	  	    			 			 	  	     		 	 	 			  		 		  			 				 	  		   	  				  	 	 	   	 				  	 			 		  				  	 			     				  	 	 	  		 	  		 	 				    				 	  	 	  		 	  	 		 	 	   	 				    	 		 	   		  	  	  		 	 				 	  				 	  		 			  	 		 	  	  				 	  	 	  	 	     		    	 	 	  	  		  			 	  		   	  	 		 				  	 				  	 	   	 	 	  		 	 		  		  	   	 	 				 	  			     		 			   			  	 	 	  	  	 	     	   	   	 	  		 		 	 	  		   	  			  		  		 	 	 		  			 		   		  			    	  		    		 		   		 	   				  	 	 	   	 	  				 	 	 	   			   	 	   	 	 		  		  	   			 		 		 	 	   	 	  			    	  		 	 				  	 		   	  				    		 	 		 	  	  	 		   	  		  	   			   	 		 				  		  	  	  	 		 		   		 	 	 	   			 	 	 	  	 	  	 	 		   		 		  		  	 	 			 			 	   	 	  	 		 	 		   	  	   	 	 		 			   			  	 	   			 	  	 	  	  	    				 	  	     	 		  	   	 	     				  	 			 			 	 	   	 		 				 				    			 	 	 		  		  	   	 	 	     	 			 		  				 	  	  		 	 	 					 		 	    	 		 	  	  	  	 		  	 	  		 			 	 	   	 		  			 	   	    			  	 	 	 	    		  	   		 	   		  	   	   		  		  	 	 	     	 				  	  		 			  		 			 	    	  	 	   	 	 	 		  		 				 			     			 		  	   	 	 	 		  	  		  		 	  		 	 	 	  		 	    		 				  	 	 	      		     			  		 		    	  		 		  	 		  	 		 	 		  		 		  		 	 	  	  		   			  	  	   	   	     	 	  				 			  	  	  	 		 		  			 	  	  	 	 	 			  			    	 	 	   	 	   	 		  		  		 	    	   		  	 					 		  	   		 				 				 	   			    	     	 	  	    		 	 		 	  		   	  			  		 				 		 	 		 				 	   		 	 	 	   	   		 				  			    	 	  	  		 			  		 			  	 	   	 	    	  	  		 	 	 	 	 	  		 	   		  		   		  		 		 				 	     	 	 		    		 				  		     				    	    	   		     		   	  		    	  		 	 	 	  	 	  	   	 	 	 					 	    	  				  	 		   	  	 		  	 	   		  	  		   	  		 	 	 	 			 	  				 	  		 	 			 			 	  	  	 		  	 	 	 	  		 	  	    	 	     	   	   			 	   		 	 	  			 			 		  		   			    		    	 	 	   	 	     	  		 	   		 			   			    	  		 	 	 	   	 			 		  		 	 	   		     	  		 	 	 	 	   	 		  	 	  		 	 	 	  		 				 	  		 		 	  			    	    	  		 		   		    	 		 				 	 		 	   			  	  		   	 			 			 	  	  	 			     		   		 				    			 	 	 	    	  		 	    	 	 	   	  	 	  	    	  		 	 	  	   			  			    	 		  	 	 		 	   			    		  			  		 		  			 	   		 	  	 	 	   	  			    			  		 	 	  	  	 		    	    		 		    	  	 		 	 	    		 			  		  			    	  		 	 		  	    		 			 			   	  		  	  	  				 	    	  	  	  	 	 		  	  	 		 	 				    	    		  		 	 	 	   	   	 		    			  		 	  			  	  	    		   	  	  		 	 	     	  		 		  	 	     		 		 	 	 		  	  		  		 	 	 		  	   	 	 	  	    	    		 			 		  			   	 		 	    			 	 	 	    	  	  			  				 	   		  	  	  				 			 	   	  		    	 		 	 	     	 	  		    		 	   	 					 	   			 	  	 		 		  			 		 	 	   			    	    		  		  		 			  		 			 			 		 				 	  	    			   	 	  		 	 		 		 	 	     	 			  		  			    	  		 	 		  	 	 	 		  	 	     	 			  	  		  		  			 			 				     	 		 	 		 	 		 	 	 		   			     			    		   	  	 					 			 	 	  		 	 	 	 	 	   			 	 	 	  		 	  		 			 	  	 	  	 	 	 	 	   	 	 		  		  		  	 	  			  	  		 		  	   			 		  	 	 	  	  	 	  	  	 		 			  		   		 	   	   		 				 	   		   			  	  		 			 	   	   			 		  			     			   	 		 	    	   		  		 	    		 	 	  			     	  				 	  			  		  	    		 	   			 	 	  		 		  		 		 	 		   	  		  			 	   	   	 	  	  		 	  	 	 	  	  	 	     	 					 				 	  		 	 	  	   			 	 	  		 	  	  	 		  		  				 	  	 	 			  			    	     	 			 		  	    	  		 	 		 			 			 		    	 	 	 		  				 	  	  	  	 				 	   			  	 		   		  		   	 	  	     		 	   	  			  	 	 	   	 					 		  	   	  		 	  		   	 		 			  		  			 	 	     	  	    	  		   	 	      			    			 			  		     			 	 	 			 		  	   			 			 			 	  	  	 			 	    		 		  		  	   		  		  	   	   		 	 	  				 	   		 			 			 		  	 	   	 		 			   	 		 	 		 				  		   	 			   	 	  		   		  		  	 	 			 	    	  		  	 	 	  		   	  	    	     	 		  		  	  	 	  	     	 		   	  			  		 	 	 		  	 	 	 	  		 	 	 			 			 	 	  	   			    	 		  	  			  	 	 	   	 			 			 		  			 	   			  		 			 	     	 			     				 	   	 		 	 	   	 	 				 	  	 	  	  	     	  		 	 	 		 	  	 	     	  		 		  		   		  		 	   	  	  	 		 	 		 		  		   			    	  	  	 	    	  		 	 	  		   		 	  		   			  		 	    		  		  		  	 		 	 	    		 		 	    		 		 	 	  		   		  		  	    	  		 		 	 		 	 	  	 	 	   	 	   	 	 		  	  		 		  	 					 	 	 		  		   		 	  	    	 	   	 			  	  			 		   			  	 	 	 			 			 			  		 			 	 		    	 	 	 	 	  	 		  		 			 	 	  		 	    		 	 					 	   			 	  		   	 	 	 	 			  	  			 			 		 	    	 	      		     		 				 	 					 		 	 		 	   		  	  	    				  	 	   			 	   		  	    	  		 		   	     	 			  	  		 			  		   		 	 					 			 			 	    		 	    	   		 			 			 			 			  	  		 			  	 	 	 	  			    	 	  	  	 		  	 				  	 			     	     	 		   	   		  		 	    		 	    	  		 			  	 	     				    	   			 	  	    		 			  		 	    	 	      		  		 		 	 	  	   		  	   	 	  		 			 				  	 		  			 	 		    			 	 	 	     	 	    	  	 					 	  	 	  		 	 	  	 	   	 	  				  		 			 		  			 	   	    		  		 		 			  		 	  	 			   	 			  		 		    	 	  	 		  	 		 	 		 		 	 			 	   	  		 	  		 	 	 		  	 	 	  			  	 	   	 	 		  	 	 	  	  	    	  		   		 	 	 		   		     	  	 	   		 		  			 	 	 	 		    				 	  	  	    	 	 	   	 					 		 	 	  	   	 	  		  		 	 	  	  	    		  		  		  		     	   	 	  			  	 		 	 	  		  			 	  				 	 					 	 	  		 	    	  			   	  		 	   	     	  		  	  		  	   	 		     			  	  		     	   			 	 	 			 		 				 		 		   		  			 	    	   	 		 	  		 		  		 	    		 	  	  		 	 	  		   	 			  	  	 	 			 	   	 	 	 	     		 			  				  	 	   			 	   		  			  	  			   	 	   	   		 	    	  	  	 		  	 	 				 	  	 	   	 	  	  	 				 	  	 					 			   	 	   		  	  	     		     			      		  		  		  		 			     	   		  			 			 		 				  		 			  		 	 	 	  	 	  	  		    			    			 	   				    		   		 	 		  	 		 	 	  	  	    	   		  			  	  	 	 	 	 	 	     	  		 	 				  	 	  			  		 	 	   		 		   		  		 		   		 				 	  	 	     	 	  	   		 	   		 			  			 	 	 		 	  	  	 		 	 	   			 			 	    		   	  		 		  	  	     		     		    	  		  		 	 	  	  	 					 		 		    		 	    		  	  	 					 	   	   	  	    	  	 		 	  				 		    	 	 	     		   		 		 	 	   			  	 	 					 	 	     	  	    	 	 		  	    	  			  		 	 		  	 	 	 	 	 		  	 	 		 				 	   			 		  	 	 			 	   			 	   	 	   	 	  	  	 		    	  		      		  		 		 	 	  	     	 	  				  		  	  			  	  	 	  	  	  	  	 	 	 		  		  		  	 	 	 	 	 	   	 	  	 		 	   	   		 		 	 	  		 	  	 		 	 	 	  		  		 	 	 	     	 			 	 	 		    	 	 	 		   		 			 		 	    		 			  	 	 	 	 	  	     		   	 			     	     	 	 	     			 			 	  		 	 		 	 	   			    	     	  			  	 	 	  	  	  	 		  			  	 		 	 	  		 				  		  	  		 			  	 	 	   		 				  		 			 	 	 	 	 	  		   				 	  			  	  	  			  		   		 	    	  	 		     		 	   	   			 		   		  		 	   	 	   	 	 					 				 	  		 		 	 			  		  	 		 	  		  	  			  	   		      			    		   		 	     	 		 	  	 	 	     			 			 	   		  	 	  		 			 		   		     	   	 	 	 	 			 			  	  			     		  			  		 		   			    	    		 			 	   	 		  	 	    	  		 		 	 		 				 			 			  		 		  				     		 	   		 	    	     	  	 		 	 			 	   		  	    			    			     	  			  	  	 	  	 	  	  	 		 	   		 	   	  	 	  		  	 	 		 	  	 		 		    	 		 	 	     	  		 			 	 	   	 	   	 	  			  	 	    	   		  	   	 		 	 		  			 			 		  		 			  	 	  		 			 		   		  	  	     	  			  	  		  	  	 	     			 	 	 		 			   		 			 	 		  	 	   		  				    	     	 	  	    	 	 			 			  		 	  	  	 		   		  		 	 	 		  			 	 		    	 	 			 	    	  	 					 		 			  	 	 	   	   	 	  			    	   		  		 		 	  	 		 	 	  				 	  				 	   			  		 	 	  	 		 	 		  	 	 	 		 	  		    	 		 			  		   	  	 		  	  			  	 		 				 		 	 	  	   	    		 			 	 		  	 	 	  		  		 	   		 	    		 		 	  		  	  		 			  	  			  			  	  	  			  			 	   		    	 		 		   			 	   	    		 	 	 	 	 		  	   		  	   	  		 	 	 	 	   	   			 		 				 			     				  	 				 	  	 		  	 		  	    		 		  	 	 		  	    	  	  	    	    		 		  	   	  		 	 				 	  	 		    	  	  	  			  	 	  	 		 	  		    		  		 	 	 	 	 	  		 	 	  		 	  		 			 	 		    	 	  		 	  			  	    		 	 	 	 	 	 	 			 		 		    		 	   				  	 	 		  	 		 	    			 		  		    	  		 			  		 	   			 		  		 			   		 			 		  	   		   	  	 	 			 	    		 	  		 	  	 		 	 		  	 	 		    	 		 	 		 	 	 		  		  		  	 					  	 		 	 			  		 		   		 	 					 	 		    	 					 		 	 		 	   			 			 		  	 	   	 			   	 			 	   	 					 			 		  	 	 			 		 	    	 	 			 		 	  	  			  	  		 	 	 				 	  		  		  			 		   		  		 		 				 	  			  				  	 			     			  	  	  				 		    	  		 			 			 		  	    		 			     		  		  	   	   		  	 	 			 		  	 	 		   		  	  		  		  	 		 	  			 	 	 			 		   		  	   		 			 	 	 	 	 		  	 	 	  	 		 		  		  			   	 		 	 		 			   	 	 					 		 	    		  			  		   	 			   	 	  		 	 	 	 	 	 	 	 			 	  	  	 			 			 	 	     	 		 	  		 		 	 	 		     	 		 	 			 	 	 		 	  	 		 				 		 		   	 	 		  	    	   		 	 	 		  	    		 			 		 			  	 	 		  		  	 	 	 	  		  	 		 	 	 	  		 		  		  	 	  		 		 			  	 		    	    		 			     	  		 	 		 		    		  		 	    	  				 	  	 	 	 	 			 		  	 	  	  	  	 	  	 	 		  	  		   	 	  	   	 		 	 	 	 	 	 	  			  			 		   		     				  	 			   	 	  	  	  		 		  		 		   			   	 		 	 	  	   			 	   	 	  		 	 	 		  		   		  	  		 	    		   		  		 			 	 		 	  		   		 		   	  	   	 	 			   	  		 	 	 	 	 			 			   	  		 		  		   	  				 	  		  		  	  	 	  				 	  				    		 		   			 	 	  		 	 	 		  	   			 	   	 		    			   	  			    			 	   		 		   		 			  	  		   			 	 	 	   			 			     			 	    		  	  			   	 	 	 			  	 		 	 	 		    	 		 	  	 	 	 	 		 		   		   	  			 	 	  			     		  		 	  				 		  	 	  		 			 	 	 		  		 	 	  			 		  		 	 	   		  	   		 		   		     			   	  		 	 	 		    	 		 	 	  		    	 		 		    	 		 	 	    		 	  	 	  		  		  	   	    	 		 	  		  	  		  	 	 			  		  			    	 					  		 	   		   	  	 	 	   	  	 		 	 	 		  	  	 		 		 		   			 			  			  	 	   	 	  		   	  	 		 	 	 	 		   			     		 	 	 	  		   				    		  	 	 	 	 			  			  	 	 	  		 		 		   	 	 			 			 	   	 	  		 			 	   	   			 		  		  		  	 	 		   	  		   	  	    	  			   	 	 		 	  	   		  	 	  		  		  	  				 	  	 		    	  		 	 				    	    	  	   	 	 		 				 	   		  	 	     	 	 		  	 	  		 		 				 		 		 	 		 	 	  	    		 	 	     		   		 		  	   		 	 		 			  	  			   	 			 	   	  			   			    		 		 	 	 		 	  	 		     		   	 	 		  	 	   	    		  	  			 	   				  	  			  	 	 					 			 			 	 	     			 			 			  		 		 			  	 	     	 	     	 	  	  			  	  	 		  	  			  	  		   	 			   	 		 	  	 		 	    				 	  	   	 	  		 	   	  		 	 	 	 	   		 	 		 		  			 		 				 		 			  		 		   	 	  	   		 			  		   	 	  	    	   			 	   	 	 	 		  	 		 		   			     		 		   			 			 		   	  			 	   		 		 	 		   		 		 		 	 	  	 	  	 	  	  			 			 	  	 		 		 		   				  	 	   	   	   	 	 			 	 	 		    	  		 	 	 	 	  	  	    	  	  	  	 		 		   	 		    		  	   		  	 	 	 	   	 			  	  			   	 	 	  		 			      		 		  		   	  			   	 		   		 	 	 			 	  	    	    		 	  		 	 	  	  	 			   	 			 	   	 	 	   				 	  	 					 	   	   			 		  	  	 		  		   	  			    		 	 	  		 		   		 		 	 			  	  	   	   			 		   	 		 	 			 		  		 	 		 	  		   	  	  	 				 	  	   		  			 	    		 		  		 				 			 	 	 		 			  		 				 		 		 	  	 		 	 	 	     	  			  	   	   	    	  			  	   		  		 	 					 	 					 	   	 	  		 	   	   			 	 	 	 	 		  		  	  	 		 	  				 		    	 	  		   		  	 	  			    	  	 	  		  		  	 		 	  	  	    	  		   	 	  	  	 	  		 	 					 		  	    		 		   		 	 	  	 		 	 		  			 		 		 	 	 	 	    	 		 	 	  	 	  	  	  	 		  		  	   		  	  			   	 		 	 	   	    		   	 	  	 	  			  	  			 			 		  	   		   	   		  		 			   	  		 	   			  	  		 	 	  		  			 		 	    		  		  	    	  		 		 	 		 		 	  	 		 	 	 	 		  		 	    			   	 	 		 	  			 		  		 	  	 	  	 	  	 	 		  	    	   			  	  		  	  		 		   		 	 		 	  		 	 				  	 	   		  	 	   	 	   	 	  	 		 	 		 	 	  	 		 	  	 	  		  	 		 	 	  		   			     		 	  	 		 				 	 	  	  	 		  	 	 		 	  	  			  			 		  	 	 		  	  			  				    			 	 	  			  	 	 	  		 	  	 		  		     				 	  	 	 	   		 				 	 		    		  		  	 		  	  			  	 		  		  	 	     		   		  			     		  	  	 		     		     		 			   	 		 	 			 			 			 			 			 			 		  			 	  			  	 	 			 	    	  	     	 				     		  		  			  	 	   		  		 	 	   			  	 		  	 	 		  		  			 			 		  	 	 			 	   	 					 	 		  	 		  	 	 		  			 		   		 	 		  	 	  			  	   		  		  			 		  	 	  		  		 		 		   	  	 	  				 	  	   	 	 		   		 	 	   	 	    	   		 	   	     	 			 			 	  				 	  				 		 	  	 	  			   		 		  		 		 	 			 			  		   	 	 	 			 			 		  	  			   			     		     				  	 		  		   		  	  		  		   		 			 	 	  	  	 	 	   		 	 		  		  	  		  		   		 	 	 			 	 	 			  	  		  	    		 	   	 	 	 	 	   	 	 			  	  		   	  	  	 	  	  			  	 	   	 	 	   	 		 	    			  		 	  		 	 	  		 	 			 			 				 	  	  		 	 	 		  	 		  	    		  	  	   		  	  				 		 	  	 	  		   	 	  		 		 	 		 		    	 	 	 	   	  	  	 	  	    		 		 	 			 			  		 	 	 	  			  		 		 	 		   	  	    		 		 	 		 	 		 	   		 			 			   	 		   		 	   			 		   		 			  	  		  			 	 	 	   			   	 		 				  			    	 	  		 	 	  		  		  	  	 	  	  	    		 		 	  	  		 	 	 	  	 	  				  	 		 		   				    		   	  	 	  		 		   	   		     	 	  	  			 			 				  	 		   		 	 	  		  		  		  			  	 		  		  			   	 		 				  			  	 		 		   			 		  	 		  	 	  				 			  		 	  		 	 		  		  			  		 		  	 	 	 	  		 	 	 			 	 	  	  		   	   		   	  			  	 	   			 	 	 		  	 		  	  		   	 		  	   		 	 	  	  	 	  	 					 			 		  	 	      		 	    	 		 	 	 		  	  		 	   			 	 	 	   	 	  		 	    	 		 	 		 	 		 				    	  	    	 	 	 	 			 	   		 				 		 	 		 	 	  	  		 	  	 		 		 	 			 	   	 	  	  	  		 	 	  	    	 	  		 	   	 	 		 				 		  	   				    				    	   	   	  	 	  	  	 	  	  	 		 		 			  				 	   		  	  			 	 	 		  		  	    		 	 					  		   	 	  		 	 		 		   	 	 		  	 	  		 	  	    	 		    	    		 		 	    	  			  				 	   	 		 	 			 	 	 	    	  	  				 		 		 	  		  		 				 	  	 	 			 		 	 	  	 		    		  		  			  	   			  	 			  		 	 	 	 	 	  	 	  			 			 			 	   		 	    				    	  		 	 	  	 	   		   	 	  				  		  	   	 		 	 		    	 	 					 	 	 			  			  	 			 	 	  		 	   			 		  	 	 	    		 			 	 	 		  	 	      		     		  	 	 	 	 			 			 		   		  		 		 		 	  			  	 	 	 			 	    	  		  	 	  		 			 			 	   	    		 		  	 	 		 		    		   	 	    	  		 		 	 	 	 			 			 	   	 	 	 	 		   	  			  	  		   	  		 	 		 				 	  	 	   	 	    		 				 	   		 	 	 	   			 	  				 				 	  		 				 				 	  	 		    	  	    	  				 	  	    				  	 	 					 	   			  		 			 				     		 	   		    	 			 		   		 	 	 		  			  	 		 	 	   		  	 		    			 	 	 	 	 	    		 			 		 	    			  	  				 	  			 	   		 	    				  	  	 		 	 	 		 	  	 		  	 	 		    	 	 	    		     	 	 			 			 			 		  	 	 		  	    			  	 			 	 	 		 				 	  				 			  	   		  	  		  		  		 		   		   	  	 	 		   		 	   		  	 	 	 					 	   		  	 		  	  		 	 	 	 	 			 		    	  		 		  			 	   	 	  	  		   		 		 	  	 			 	 	  		 	 	 	  	    	 		 	  			 		  		 	 	  	    		  		  	  	   		   		 	 	 			 	 	 	  		   			     		 		   	  		   	   		  		   		 		  		  	  		   			 	 	  		      			  	 	  			  			   	 	 	 		  				  	 		  	   	   		   		 			 		 	     	 		 	  		   	  	 		 	  		  		  		   	 	 	  		 	  	 		 	  		   	   			  		 			  		  	  				  	 		  	   	 	   	  			    	  	    			 		  	 	 		   		  		 			 		  	 	     		 	 	  	   			  			  	 			 		  		   		 	  	  	  	 		 	 	 	 	   	  	  	 		 		 	 			 	   				    		  		  		   	  	  				 		 				 		 		   	  		   			      		 			 			 	   	  		 	 			     	    	   		  	  	 		 	   		   	 		 	  	 	    	  	 		     		 			 		  		  	  	 	   			  	 	   		  	    		 			     			 	 	 	    		 		 	 	  			 	 	 	 		 	   		 	   		  	 	 	  		   		   		 	 	     	   	 	 		 		 	 	  		    		  	   	 		 	 		 	  	 	     	 	  	     		 			 	 	   	 	  	 	  	 	 			 		  	    		   	  		     	  				  	 		 	 	  	 		 		  	 	 		   		 		  	 	 		   	   		 	 	 		   	  		  		  	  			  	    	  			 		  			 	 	 	  	    		 	 		 	 		  	 		 	 	  	 	 	 	  		 	   		 				  		 			 			     	   			 		 				  		 	 	 	   	 	 		 		   		    	 	 	 		  	  		   	 	 	 	 			 			 	  	 		 	   		  	   			 	     	 		    	 		 		   	  			  		 			  	 	 	 	 	  	  	 		 	 		 				 	  		  			 	   	 	 		 		 	 	 	  		 		 		   	  			  			  	  	 	 			 			     		 		 	 			 	 	 	 		  	 			   	 		 			  	 		    			   	 	  	  	 	  			  	 		    	   			 	 	 		   		 			 		  	 	 			  	  	  		 	  		 	 	 	 	 	 	 				 	  	  	     		     		  			 		 			  	  	    			     	   			 	   		  	   			 		  	 	 	 		    	 		 	  		 	    		 		    		  		 	 	 		  		 			  			   	  			    	   	   		 		   		  		  	 	 			 	  	    	 	 		  	 		  	  			     		   	 	   	 	  		 		  		 				  			  	  		 			 	   			  		  	  	   	   		   	  	   	   	 	  	   			  	 			 		  		 		   	 		  	 		   	  			  	  		 	  	  	 		 	  		  		 	 		 	   		 		  	 	      		  	  		  		  		 	 	  		 		   			  	   		 	   		  	   		  	 	  	 		 	 			 		  		 	  	 				    			   	 		  			  	 		 	 	 	      			  	 				  	  		 	   		 	 		  		 		  		  		   		      		     	 		    	 	  	   		  	   		 	 	 	 	 			 				    	 	  	  	  	    			  		 	 	 	   		 	  	 		   	  		 			  	 	   	 		 				 	 	 	    		 		  	  				 		  	 	 	    		 		 	 		 		 	 	  			     			 	    			  	  			  	 	  			  		 	 	  			   	  		 			 	 	 			 	    		  		  		 	 	 	    			  	 			 	 	 		 	    			     		   		  			  	 	 	   	 	  	 	  	  	 		 			 	 	 	  	 	   		     	  	 		  		 		  		 		   		 		 	 	  	 	  	 		 	   	 		 	 		 	 		 	 	     			 		  	 	 			 		    	  			  	  		   	  		     		 	 		 				  	 			 			 		 		 	 				    	  	 		 			   	 		   	  			 	 	 		  			 		 	 	  	   			 			   	 	 	 		   		 			 	 	     	 	 	   		 			  		 			  		 	     		 		   			    		 				 	 	     	 	  		 	    		 			 	 	 			   	  			    		 				 			 	 	  	 		 	  		 			 	  	     		 	   	 	 	   		 	    	 	      		  	  				 	  			 	 	  	 		 	 	 	 			  		  	  	  		    	 		 	  		 		  		 			  	   	    		   	 			 			 			 	 	  		 			 			   	  		 		   		   	 		  		  		  	    		   	 	 	   	  			    	 		    		 	    	  		   	 	     	   		  			  	  	  			  		   	   		  		 		 	    			 	 	 	 	 		  			 	 	 			 	    		  	   		  	  			 	 	 			  	   		 		   		 		  		  	 	 	    	  	 	  		 	 	  		 			   	 				 	  		  		   			  	  		  	   			    	 	 		  		  		   	 		 	 				  	  			  	 		  		  			 		   		     			  	   			  	 			  		 		 		 	 		 		    			  	 		  	 	 		  		  	    		 	   	   	    		 		  		  		   	  		  	 	  		 		  			   	 				    			   	 	 	 		  				  	  		 		  			  	  	 	 	 	  		   	 		  	   	  			   		  		 	   	 	  			  	 	 	  		 	  		 	 		 		 	 	  		   		 	 	   		 	 	 	  				 	   	   	 		 	  		    	 	  		 	 	 	 		  	   	 	 	  	 	  		   	  		 	 		 	   		  		  	 	 		    	 		 	 	  		 		 	 		   		 	  				  			    	  	 	   		  	  	  		   	  			  			 	   	  	 	  			  	  	  			  	 	  		 	 	  		 				  	 		 	 		 	 	     	  		   	  		 	 		 	    		   		 		   	  	   	   	 	 	   	 	 	 	 	 	 	   			 			 		 		   	 	 	   	  	 		 	  				 	  	 	  	  				 		  	 	 	 		 	  	 	 	   	  		 	  		   	  	 		 	 	 	     	 		    		  		 
 		 	
